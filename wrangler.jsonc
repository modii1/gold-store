{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": "worker.js",
	"name": "gold-store",
	"compatibility_date": "2026-08-10",
	// جدولة Cloudflare: كل 15 دقيقة POST إلى /api/recovery/run.
	// المسار يقرأ settings.recovery_enabled ويتوقف كليًا عند OFF.
	// يمرّر x-cron-secret من بيئة الـWorker، وإن غاب ⇒ لا يُرسل شيء (fail-closed).
	"triggers": {
		"crons": ["*/15 * * * *"]
	},
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"vars": {
		"NEXT_PUBLIC_SUPABASE_URL": "https://urofqjjfushrurnykgec.supabase.co",
		"NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_bsiyKcWRrt4VcYtqABOu2w_GgCAtIxI"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "gold-store"
		}
	],
	"r2_buckets": [
		// Use R2 incremental cache
		// See https://opennext.js.org/cloudflare/caching
		{
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			// Create the bucket before deploying
			// You can change the bucket name if you want
			// See https://developers.cloudflare.com/workers/wrangler/commands/#r2-bucket-create
			"bucket_name": "gold-store-opennext-cache"
		}
	]
}